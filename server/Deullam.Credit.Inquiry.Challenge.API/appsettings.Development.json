{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Credenciais de desenvolvimento local. Sao as mesmas do server/.env.example, que o
  // docker-compose.yml usa para subir o PostgreSQL e o Kafka, e valem apenas para o ambiente
  // local: os enderecos apontam para as portas que o compose publica no host.
  //
  // Dentro do container a API nao usa estes valores: o docker-compose.yml injeta
  // ConnectionStrings__DefaultConnection e ConnectionStrings__Kafka como variaveis de ambiente,
  // que tem precedencia sobre este arquivo.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=credit_inquiry_db;Username=credit_user;Password=credit_local_dev",
    "Kafka": "localhost:29092"
  }
}
