# =================================================
# Variáveis de ambiente usadas pelo docker-compose.yml.
#
# `make up` copia este arquivo para .env se ainda não existir, então o ambiente
# local sobe sem edição nenhuma. Os valores abaixo são credenciais de
# desenvolvimento local e batem com server/Deullam.Credit.Inquiry.Challenge.API/
# appsettings.Development.json, que é o que a API usa quando roda fora do
# container (por exemplo em `dotnet ef database update`).
#
# Para qualquer ambiente que não seja a sua máquina, troque estes valores.
# =================================================

# Credenciais do banco PostgreSQL
DB_USER=credit_user
DB_PASSWORD=credit_local_dev
DB_NAME=credit_inquiry_db

# Endereço do broker Kafka visto de dentro da rede do compose.
# Do host, o mesmo broker responde em localhost:29092.
KAFKA_CONNECTION_STRING=kafka:9092
